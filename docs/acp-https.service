[Unit]
Description=ACP panel HTTPS front (secure context for voice input on the LAN)
After=network.target acp-ui-web.service
Wants=acp-ui-web.service

[Service]
Type=simple
WorkingDirectory=%h/projects/acp-ui/server
ExecStart=/usr/bin/node %h/projects/acp-ui/server/https-front.mjs
Environment=ACP_TLS_DIR=%h/.hermes/acp-tls
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
