[Unit]
Description=ACP UI shared state server (panel KV store on the host)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/node %h/projects/acp-ui/server/acp-state-server.mjs
Environment=STATE_DIR=%h/.hermes/acp-ui-state
Environment=PORT=25900
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
