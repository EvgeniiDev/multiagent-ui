[Unit]
Description=ACP UI researcher wakeup — collect sources, then one researcher run
After=acp-state.service
Requires=acp-state.service

[Service]
Type=oneshot
# collect.py (no model) -> only if new items: spawn the researcher role.
ExecStart=%h/projects/acp-ui/scripts/research/wakeup.sh
Environment=STATE_URL=http://127.0.0.1:25900
Environment=PATH=%h/.local/bin:%h/bin:/usr/local/bin:/usr/bin:/bin
# Optional knobs (defaults shown):
# Environment=PM_SCOPE=acp-ui          # project label = sources.<scope>.json
# Environment=PM_ROLE_ID=researcher    # roles.json entry to spawn
# Environment=RESEARCH_PY=%h/.hermes/tools-venv/bin/python
# tg-read and boardctl must resolve via PATH (they live in ~/.local/bin).
