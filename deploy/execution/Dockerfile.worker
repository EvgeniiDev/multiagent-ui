# F1 worker image — pinned, immutable, minimal.
# Same CLI payload as the prod node image (pi 0.85.1) plus the F1 boundary
# shim and proc probe baked in at fixed paths. Built via compose:
#   docker compose --profile f1 build env-controller   (tags acp-f1-worker)
FROM node:22-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends libatomic1 bash git python3 ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*
RUN npm install -g @earendil-works/pi-coding-agent@0.85.1 \
 && npm cache clean --force
# Deterministic uid/gid the deployment pins workers to.
RUN groupadd -g 1001 acp && useradd -u 1001 -g 1001 -m -s /bin/sh acp
COPY deploy/pi-rpc-boundary.mjs /opt/env/pi-rpc-boundary.mjs
COPY deploy/execution/proc-probe.mjs /opt/env/proc-probe.mjs
RUN chmod 0755 /opt/env/pi-rpc-boundary.mjs /opt/env/proc-probe.mjs
# Workers run with Cmd ['sleep','infinity'] + read-only rootfs; control
# flows through the controller's docker exec gate only.
USER 1001:1001
WORKDIR /work
CMD ["sleep", "infinity"]
