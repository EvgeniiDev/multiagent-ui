@@ -0,0 +1,149 @@
+"""Cursor-owning, bounded progress observation without model-level polling."""
+from __future__ import annotations
+
+import argparse
+import json
+import math
+import re
+import sys
+import time
+from pathlib import Path
+
+from .registry import Registry, RegistryError
+from .util import atomic_write_json, ensure_dir, flock_exclusive, utc_now_iso
+
+
+def consumer_name(value):
+    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,63}", value):
+        raise argparse.ArgumentTypeError("consumer must be 1–64 safe characters, starting with a letter or digit")
+    return value
+
+
+def timeout_seconds(value):
+    try:
+        result = float(value)
+    except ValueError as exc:
+        raise argparse.ArgumentTypeError("timeout must be a number between 0 and 60") from exc
+    if not math.isfinite(result) or not 0 <= result <= 60:
+        raise argparse.ArgumentTypeError("timeout must be between 0 and 60 seconds")
+    return result
+
+
+def nonnegative_cursor(value):
+    try:
+        result = int(value)
+    except ValueError as exc:
+        raise argparse.ArgumentTypeError("cursor must be a nonnegative integer") from exc
+    if result < 0:
+        raise argparse.ArgumentTypeError("cursor must be a nonnegative integer")
+    return result
+
+
+def page_size(value):
+    result = nonnegative_cursor(value)
+    if not 1 <= result <= 100:
+        raise argparse.ArgumentTypeError("max-events must be between 1 and 100")
+    return result
+
+
+def observe(reg, run_id, consumer, *, timeout=60, max_events=20,
+            cursor=None, include_thinking=False, emit=None):
+    # Local import avoids a cycle with the CLI parser in control.
+    from .control import event_page
+
+    consumer_name(consumer)
+    reg.load_meta(run_id)  # Validate ownership/existence before creating state.
+    directory = ensure_dir(reg.run_path(run_id) / "observers")
+    state_path = directory / f"{consumer}.json"
+    # This is a consumer lock, never the worker lifecycle lock. Fail fast on a
+    # second reader rather than wait outside the requested observation deadline.
+    try:
+        with flock_exclusive(directory / f"{consumer}.lock", blocking=False):
+            saved = {}
+            if state_path.exists():
+                try:
+                    saved = json.loads(state_path.read_text(encoding="utf-8"))
+                    if (not isinstance(saved, dict) or saved.get("version") != 1
+                            or saved.get("run_id") != run_id
+                            or saved.get("consumer") != consumer
+                            or type(saved.get("next_cursor")) is not int
+                            or saved["next_cursor"] < 0):
+                        raise ValueError("invalid checkpoint")
+                except (ValueError, OSError) as exc:
+                    raise RegistryError("observer checkpoint is unreadable/invalid; restore it or use a new consumer", exit_code=1) from exc
+            start = saved.get("next_cursor", 0) if cursor is None else cursor
+            deadline = time.monotonic() + timeout
+            current = start
+            omitted = 0
+            while True:
+                page = event_page(reg, run_id, current, max_events)
+                if page.get("cursor_reset"):
+                    raise RegistryError("event journal shrank; choose an explicit --cursor for deliberate replay", exit_code=1)
+                current = page["next_cursor"]
+                events = []
+                for item in page["events"]:
+                    if item.get("type") == "thinking_delta" and not include_thinking:
+                        omitted += 1
+                        continue
+                    event = dict(item)
+                    data = event.get("data")
+                    if isinstance(data, str) and len(data) > 500:
+                        event["data"] = data[:500]
+                        event["data_truncated"] = True
+                    events.append(event)
+                changed = (bool(saved) and (page["status"], page["exit_code"])
+                           != (saved.get("status"), saved.get("exit_code")))
+                timed_out = time.monotonic() >= deadline
+                if events or page["terminal"] or changed or timed_out:
+                    result = {**page, "cursor": start, "events": events,
+                              "consumer": consumer, "observed_at": utc_now_iso(),
+                              "quiet": not events,
+                              "timed_out": timed_out and not (events or page["terminal"] or changed),
+                              "thinking_omitted": omitted}
+                    # Flush delivery before checkpointing. A failed stdout write
+                    # must not silently consume unseen events. Crash after delivery
+                    # but before checkpoint can replay: this is at-least-once.
+                    if emit is not None:
+                        emit(result)
+                    atomic_write_json(state_path, {
+                        "version": 1, "run_id": run_id, "consumer": consumer,
+                        "next_cursor": current, "status": page["status"],
+                        "exit_code": page["exit_code"],
+                        "observed_at": result["observed_at"],
+                    })
+                    return result
+                if page["remaining"]:
+                    continue  # Drain pages of omitted thinking before waiting.
+                time.sleep(min(1.0, max(0, deadline - time.monotonic())))
+    except BlockingIOError as exc:
+        raise RegistryError("another observer owns this consumer; retry later or use a distinct consumer", exit_code=5) from exc
+
+
+def cmd_observe(args):
+    reg = Registry(Path(args.registry_root) if args.registry_root else None)
+
+    def deliver(payload):
+        print(json.dumps(payload, ensure_ascii=False), flush=True)
+
+    try:
+        result = observe(reg, args.run_id, args.consumer, timeout=args.timeout,
+                         max_events=args.max_events, cursor=args.cursor,
+                         include_thinking=args.include_thinking, emit=deliver)
+    except (RegistryError, OSError) as exc:
+        sys.stderr.write(f"Error: {exc}\n")
+        return getattr(exc, "exit_code", 1)
+    # This command observes progress, not acceptance or the final answer.
+    return 124 if result["timed_out"] and result["quiet"] and not result["terminal"] else 0
+
+
+def add_observe_command(sub):
+    parser = sub.add_parser("observe", description="Read only new progress with a durable per-consumer cursor; wait up to 60s when quiet.")
+    parser.add_argument("run_id")
+    parser.add_argument("--consumer", required=True, type=consumer_name,
+                        help="stable, distinct observer identity across calls")
+    parser.add_argument("--timeout", type=timeout_seconds, default=60)
+    parser.add_argument("--max-events", type=page_size, default=20)
+    parser.add_argument("--cursor", type=nonnegative_cursor,
+                        help="explicit raw-line cursor override for deliberate replay")
+    parser.add_argument("--include-thinking", action="store_true")
+    parser.set_defaults(func=cmd_observe)
