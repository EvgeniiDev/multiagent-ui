+"""Offline regressions: cursor continuity and substantive progress delivery."""
+import json
+import os
+import subprocess
+import tempfile
+import threading
+import time
+import unittest
+from pathlib import Path
+
+from steer.control import event_page
+from steer.observation import observe
+from steer.registry import Registry, RegistryError
+from steer.util import atomic_write_json, flock_exclusive
+
+PORCH = Path(__file__).resolve().parents[2] / "porch"
+
+
+class ObservationTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory(prefix="porch-observe-")
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name)
+        self.reg = Registry(self.root / "registry")
+        artifacts = self.root / "artifacts"
+        self.run = self.reg.create_run(agent_id="devin", backend="fake", model="fake",
+                                   cwd=str(self.root), artifacts_dir=str(artifacts))
+        self.events = artifacts / "normalized" / "devin.jsonl"
+        self.events.parent.mkdir(parents=True)
+        self.events.write_text("")
+        self.checkpoint = self.reg.run_path(self.run) / "observers" / "lead.json"
+
+    def append(self, kind, data=""):
+        with self.events.open("a") as stream:
+            stream.write(json.dumps({"type": kind, "data": data}) + "\n")
+
+    def read(self, **kwargs):
+        return observe(self.reg, self.run, "lead", timeout=0, **kwargs)
+
+    def cli(self, *args):
+        env = {**os.environ, "PORCH_STEER_DIR": str(self.reg.root), "PYTHONDONTWRITEBYTECODE": "1"}
+        return subprocess.run([str(PORCH), "delegate", "observe", self.run,
+                               "--consumer", "lead", *args], env=env,
+                              text=True, capture_output=True, timeout=10)
+
+    def test_no_replay_and_new_events_after_restart(self):
+        self.append("tool_started", "contract")
+        self.assertEqual(self.read()["events"][0]["data"], "contract")
+        self.assertEqual(self.read()["events"], [])
+        self.append("answer_delta", "first slice ready")
+        again = observe(Registry(self.reg.root), self.run, "lead", timeout=0)
+        self.assertEqual([x["data"] for x in again["events"]], ["first slice ready"])
+        self.assertEqual(again["cursor"], 1)
+
+    def test_pagination_preserves_errors_after_thinking(self):
+        self.append("thinking_delta", "private stream")
+        self.append("error", "invalid response")
+        first = self.read(max_events=1)
+        self.assertEqual(first["events"], [])
+        self.assertEqual(first["remaining"], 1)
+        second = self.read(max_events=1)
+        self.assertEqual(second["events"][0]["type"], "error")
+        self.assertEqual(second["next_cursor"], 2)
+
+    def test_omitted_thinking_does_not_wake_waiter(self):
+        self.append("thinking_delta", "still thinking")
+        started = time.monotonic()
+        result = observe(self.reg, self.run, "lead", timeout=0.03)
+        self.assertGreaterEqual(time.monotonic() - started, 0.025)
+        self.assertTrue(result["timed_out"])
+        self.assertEqual(result["next_cursor"], 1)
+        self.assertEqual(result["thinking_omitted"], 1)
+
+    def test_real_new_event_wakes_before_deadline(self):
+        producer = threading.Thread(target=lambda: (time.sleep(0.03), self.append("tool_finished", "test failed")))
+        producer.start()
+        result = observe(self.reg, self.run, "lead", timeout=2)
+        producer.join()
+        self.assertFalse(result["timed_out"])
+        self.assertEqual(result["events"][0]["data"], "test failed")
+
+    def test_independent_consumers(self):
+        self.append("error", "new failure")
+        self.read()
+        other = observe(self.reg, self.run, "review", timeout=0)
+        self.assertEqual(other["events"][0]["data"], "new failure")
+
+    def test_partial_line_is_delivered_after_completion(self):
+        self.events.write_text('{"type":"error","data":"crash"}')
+        self.assertEqual(self.read()["next_cursor"], 0)
+        with self.events.open("a") as stream:
+            stream.write("\n")
+        self.assertEqual(self.read()["events"][0]["data"], "crash")
+
+    def test_shrunk_journal_requires_explicit_replay(self):
+        self.append("error", "first")
+        self.read()
+        self.events.write_text("")
+        with self.assertRaisesRegex(RegistryError, "shrank"):
+            self.read()
+        self.assertEqual(json.loads(self.checkpoint.read_text())["next_cursor"], 1)
+        self.append("error", "replacement")
+        self.assertEqual(self.read(cursor=0)["events"][0]["data"], "replacement")
+
+    def test_corrupt_checkpoint_does_not_silently_replay(self):
+        self.read()
+        self.checkpoint.write_text("broken")
+        with self.assertRaisesRegex(RegistryError, "checkpoint"):
+            self.read()
+        self.assertEqual(self.checkpoint.read_text(), "broken")
+
+    def test_failed_delivery_preserves_cursor(self):
+        self.read()
+        before = self.checkpoint.read_bytes()
+        self.append("error", "must not disappear")
+
+        def fail(_):
+            raise BrokenPipeError("delivery failed")
+
+        with self.assertRaises(BrokenPipeError):
+            self.read(emit=fail)
+        self.assertEqual(self.checkpoint.read_bytes(), before)
+        self.assertEqual(self.read()["events"][0]["data"], "must not disappear")
+
+    def test_compact_preview_and_legacy_detail(self):
+        self.append("answer_delta", "x" * 1200)
+        compact = self.read()["events"][0]
+        self.assertEqual(len(compact["data"]), 500)
+        self.assertTrue(compact["data_truncated"])
+        detail = event_page(self.reg, self.run, 0)["events"][0]
+        self.assertEqual(len(detail["data"]), 1200)
+
+    def test_busy_consumer_does_not_block_lifecycle(self):
+        self.read()
+        lock = self.checkpoint.with_suffix(".lock")
+        with flock_exclusive(lock):
+            with self.assertRaisesRegex(RegistryError, "another observer"):
+                self.read()
+
+    def test_status_change_and_terminal_without_events(self):
+        self.read()
+        meta = self.reg.load_meta(self.run)
+        meta["status"] = "running"
+        atomic_write_json(self.reg.run_path(self.run) / "meta.json", meta)
+        changed = self.read()
+        self.assertFalse(changed["timed_out"])
+        meta.update(status="failed", exit_code=1)
+        atomic_write_json(self.reg.run_path(self.run) / "meta.json", meta)
+        result = self.read()
+        self.assertTrue(result["terminal"])
+        self.assertEqual(result["exit_code"], 1)
+
+    def test_cli_continuity_and_quiet_exit(self):
+        self.append("tool_started", "contract check")
+        first = self.cli("--timeout", "0")
+        self.assertEqual(first.returncode, 0, first.stderr)
+        self.assertEqual(json.loads(first.stdout)["next_cursor"], 1)
+        second = self.cli("--timeout", "0")
+        self.assertEqual(second.returncode, 124, second.stderr)
+        self.assertEqual(json.loads(second.stdout)["events"], [])
+
+    def test_cli_rejects_invalid_limits_and_consumer(self):
+        for args in [("--timeout", "nan"), ("--timeout", "61"),
+                     ("--max-events", "0"), ("--consumer", "../other")]:
+            result = self.cli(*args)
+            self.assertNotEqual(result.returncode, 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
