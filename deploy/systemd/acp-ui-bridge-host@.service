[Unit]
Description=Multiagent UI host bridge %i (exclusive mode-managed owner)
After=network-online.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin
Environment=HOME=%h
Environment=NODE_PATH=%h/.local/lib/node_modules
Environment=ACP_STATE_URL=http://127.0.0.1:25900
Environment=ACP_BRIDGE_MODE_FILE=%h/.config/acp-ui-bridge-state/selected
Environment=ACP_BRIDGE_LOCK_DIR=%h/.config/acp-ui-bridge-state/locks
EnvironmentFile=%h/projects/acp-ui/deploy/bridge-host-%i.env
WorkingDirectory=%h/projects/acp-ui
ExecStartPre=%h/.local/bin/node %h/projects/acp-ui/scripts/acp-bridges.mjs preflight --mode host
ExecStartPre=%h/.local/bin/node %h/projects/acp-ui/scripts/acp-bridges.mjs guard-start --mode host --bridge %i
ExecStart=%h/projects/acp-ui/deploy/acp-bridge-launcher.sh %i %h/.local/bin/node %h/projects/acp-ui/deploy/acp-ws-bridge.mjs --port ${ACP_BRIDGE_PORT} --cmd "${ACP_BRIDGE_COMMAND}" --agent-name "${ACP_BRIDGE_AGENT_NAME}" --required-mode host
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=5
TimeoutStopSec=60
KillMode=control-group

[Install]
