[Unit]
Description=Multiagent UI web bundle (LAN static server)
Documentation=https://github.com/EvgeniiDev/multiagent-ui/blob/main/docs/lan-deployment.md
After=network-online.target

[Service]
Type=simple
# Serve the web build produced by `npm run build:web` (dist-web/).
WorkingDirectory=%h/projects/acp-ui/dist-web
ExecStart=/usr/bin/python3 -m http.server 25808 --bind 127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
