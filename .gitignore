# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
dist-web
*.local

# Tauri build artifacts
src-tauri/target

# Tauri generated files (mobile builds, schemas)
src-tauri/gen/android
src-tauri/gen/apple

# Rust
*.rs.bk
Cargo.lock

# Environment files (may contain secrets)
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editor directories and files
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Build outputs
*.exe
*.msi
*.dmg
*.AppImage
*.deb
*.rpm

# per-card run artefacts (role prompts stay tracked)
.acp/cards/

# python bytecode from the e2e suites
scripts/__pycache__/

# e2e scratch dirs (each suite makes its own; never source)
tmp-*-test/

# Local devin config for the sandbox tree (workspace trust off).
devin.json

# e2e suites regenerate these every run (binary, conflicts on every merge)
docs/*.png

# per-workstream brief written by the orchestrator (scratch, not source)
BRIEF.md
CONTINUE.md

# pm-wakeup run artefacts (briefs, logs, reports — runtime, not source)
.acp/pm/
# researcher runs + collector state (digests, seen-sets — runtime, not source)
.acp/research/
# per-Porch-run transient scratch; durable deliverables belong in tracked paths
/.agent-tmp/
